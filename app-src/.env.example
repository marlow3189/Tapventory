# ============================================================================
# Tapventory — konfiguracja lokalna (DEV)
# Skopiuj ten plik jako ".env" (bez .example) i uzupełnij wartości.
# Plik .env jest w .gitignore — sekret nie trafia do repozytorium.
# ============================================================================

# Adres lokalnego Supabase (po `supabase start` — patrz docs/00_INSTRUKCJA_BUDOWY_ETAPAMI.md, Etap 3)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Klucz "anon" z wyniku polecenia `supabase status` (pole: anon key).
# To klucz publiczny — o dostępie do danych decyduje RLS, nie ten klucz.
EXPO_PUBLIC_SUPABASE_ANON_KEY=wklej_wartosc_z_supabase_status

# Środowisko (lokalnie zawsze development)
APP_ENV=development
