# ============================================================================
# Tapventory (mobile) - konfiguracja lokalna.  Skopiuj ten plik jako ".env".
# Plik .env jest w .gitignore - sekretow nie wrzucamy do repozytorium.
# ============================================================================

# --- Wariant A: lokalny Supabase (npx supabase start) -----------------------
# Przegladarka (PWA) i symulator iOS:      http://127.0.0.1:54321
# Emulator Androida (widzi komputer jako): http://10.0.2.2:54321
# Prawdziwy telefon w tej samej sieci Wi-Fi: http://<IP-komputera>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Klucz "anon" (publiczny z zalozenia; o dostepie decyduje RLS w bazie).
# Pobierz: npx supabase status  ->  pole "anon key" (lub "Publishable key")
EXPO_PUBLIC_SUPABASE_ANON_KEY=wklej_klucz_anon

# --- Wariant B: projekt w chmurze Supabase ----------------------------------
# Project URL i klucz anon: panel Supabase -> Project Settings -> API
# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Srodowisko aplikacji: development | staging | production
# (zmienia nazwe i identyfikator paczki; lokalnie zawsze development)
APP_ENV=development
