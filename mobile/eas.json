{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "WKLEJ_URL_PROJEKTU_DEV",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WKLEJ_KLUCZ_ANON_DEV"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_SUPABASE_URL": "WKLEJ_URL_PROJEKTU_TEST",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WKLEJ_KLUCZ_ANON_TEST"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_URL": "WKLEJ_URL_PROJEKTU_PROD",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "WKLEJ_KLUCZ_ANON_PROD"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
