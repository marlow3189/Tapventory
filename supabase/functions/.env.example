# ============================================================================
# Sekrety Edge Functions — SZABLON. Skopiuj do `supabase/functions/.env` (ten plik jest w .gitignore)
# i uzupełnij. NIGDY nie commituj prawdziwych wartości.
#   Lokalnie:   npx supabase functions serve --env-file supabase/functions/.env
#   Na serwerze: npx supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# SUPABASE_URL oraz klucz serwisowy (SUPABASE_SERVICE_ROLE_KEY albo SUPABASE_SECRET_KEYS) Supabase dokłada funkcjom sam
# (na serwerze i lokalnie). Tylko gdyby funkcja zgłaszała brak klucza serwisowego: TV_SERVICE_KEY — patrz README.md.
# ============================================================================

# --- AI (odczyt faktur ze zdjęć, asystent) -------------------------------------
# Klucz z https://platform.claude.com → API keys. Płatny; ustaw limit wydatków w panelu Anthropic.
ANTHROPIC_API_KEY=sk-ant-WSTAW-SWOJ-KLUCZ

# Modele i „wysiłek myślenia" (domyślne wartości są rozsądne; zmieniaj dopiero po teście: npm run eval:run)
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL_STRONG=claude-sonnet-5-5
# AI_MODEL_ASSISTANT=claude-haiku-5-5
# AI_EFFORT_FAST=medium
# AI_EFFORT_STRONG=high
# AI_ESCALATE=true
# AI_TIMEOUT_MS=120000
# ASSISTANT_DAILY_LIMIT=30

# --- Harmonogram (cron-tasks, send-push) -----------------------------------------
# Wspólny sekret nagłówka x-cron-secret. Wygeneruj długi, losowy ciąg:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=WSTAW-LOSOWY-CIAG-MIN-32-ZNAKI

# --- KSeF -------------------------------------------------------------------------
# Klucz AES-256 (32 bajty, base64), którym szyfrujemy tokeny KSeF klientów, ZANIM trafią do bazy.
# Wygeneruj:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Zgub go = wszystkie zapisane tokeny przestaną działać (klienci wkleją je ponownie). Zrób kopię w menedżerze haseł.
# Rotacja: nowy klucz na początku listy, stary po przecinku:  KSEF_TOKEN_KEY=nowy,stary  (patrz docs/10_KSEF.md)
KSEF_TOKEN_KEY=WSTAW-KLUCZ-BASE64-32-BAJTY

# --- Pozostałe (opcjonalne) ---------------------------------------------------------
# Token Expo, jeśli włączysz „Enhanced Security for Push Notifications" w koncie Expo.
# EXPO_ACCESS_TOKEN=
# Nagłówek User-Agent dla Open Food Facts (prośba właściciela API: podaj kontakt)
# BARCODE_USER_AGENT=Tapventory/1.0 (kontakt@tapventory.com)
