{
  // Sprawdzanie typów zestawu ewaluacyjnego (npm run eval:typecheck).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["../mobile/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
